{
  "name": "@jund/core",
  "version": "0.1.0",
  "description": "Platform-agnostic headless coding agent.",
  "keywords": [
    "agent",
    "browser",
    "coding-agent",
    "headless",
    "just-bash",
    "llm"
  ],
  "homepage": "https://github.com/blindmansion/jund",
  "bugs": {
    "url": "https://github.com/blindmansion/jund/issues"
  },
  "license": "MIT",
  "author": "blindmansion",
  "repository": {
    "type": "git",
    "url": "https://github.com/blindmansion/jund.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js"
    },
    "./openrouter-sdk": {
      "types": "./dist/openrouter-sdk.d.ts",
      "import": "./dist/openrouter-sdk.js"
    },
    "./tanstack-ai": {
      "types": "./dist/tanstack-ai.d.ts",
      "import": "./dist/tanstack-ai.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "explore": "bun scripts/explore-ai-sdk.ts",
    "smoke:llm": "bun scripts/session-smoke.ts",
    "demo:just-bash:minimal": "bun scripts/demo-just-bash-minimal.ts",
    "demo:interactive": "bun scripts/demo-interactive.ts",
    "demo:conversation": "bun scripts/demo-conversation.ts",
    "test": "bun test",
    "format": "oxfmt --write .",
    "lint": "oxlint --fix",
    "check": "bunx tsc --noEmit && oxfmt --write . && oxlint --fix",
    "knip": "knip"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.66",
    "@openrouter/sdk": "^0.11.2",
    "@tanstack/ai": "^0.10.0",
    "@types/bun": "latest",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.11.0",
    "ai": "^6.0.146",
    "just-bash": "^2.14.0",
    "knip": "^6.3.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "pg": "^8.13.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@openrouter/sdk": "^0.11.2",
    "@tanstack/ai": "^0.10.0",
    "ai": "^6.0.146"
  },
  "peerDependenciesMeta": {
    "@openrouter/sdk": {
      "optional": true
    },
    "@tanstack/ai": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  }
}
